# Environment variables configuration example
BASE_URL=https://example.com/
SPREADSHEET_ID=1abc1234567890abcdefghijklmnopqrstuvwxyz
UPLOAD_TO_SHEETS=true # Set to 'false' or '0' to skip Google Sheets upload (e.g. during debug)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
DEPLOYED_URL=https://script.google.com/macros/s/AKfycbx_EXAMPLE_ID/exec

# Anti-Spam & Rate Limiting Configuration
CRAWL_MIN_DELAY_MS=1500 # Minimum delay between requests in milliseconds
CRAWL_MAX_DELAY_MS=3500 # Maximum delay between requests in milliseconds
CRAWL_MAX_RETRIES=3     # Max retries on rate limit (429/503) or error
BLOCK_RESOURCES=false   # Set to 'true' to block images/media/fonts to reduce server load
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
